  "operator_receipt_schema": {
    "path_key": "operator_receipt_path",
    "ready": {
      "episode_id": "current pending episode_status.episode_id from env.observe/status before reset",
      "event": "ready",
      "source": "operator_local",
      "request_id": "generated by robots.yam.operator_control.write_receipt",
      "created_at_s": 0.0,
      "note": "operator confirms manual scene reset and robot readiness"
    },
    "success": {
      "episode_id": "current running episode_status.episode_id after reset",
      "event": "success",
      "source": "operator_local",
      "request_id": "generated by robots.yam.operator_control.write_receipt",
      "created_at_s": 0.0,
      "note": "operator records task success"
    },
    "failure": {
      "episode_id": "current running episode_status.episode_id after reset",
      "event": "failure",
      "source": "operator_local",
      "request_id": "generated by robots.yam.operator_control.write_receipt",
      "created_at_s": 0.0,
      "note": "operator records task failure"
    },
    "abort": {
      "episode_id": "current running episode_status.episode_id after reset",
      "event": "abort",
      "source": "operator_local",
      "request_id": "generated by robots.yam.operator_control.write_receipt",
      "created_at_s": 0.0,
      "note": "operator aborts local run"
    }
  },
  "notes": [
    "set extrinsics_path to the RLinf solve_handeye output, e.g. /path/to/RLinf/toolkits/calibration/<capture>/extrinsics.json",
    "constructor opens no hardware; first observe/reset/step opens cameras before CAN runtime",
    "reset consumes a matching local ready receipt, then creates a fresh episode_id; it never moves to start_qpos14/home_qpos14",
    "motion is refused until a matching ready receipt has been consumed for the current reset cycle",
    "success/failure/abort are only recorded from matching operator_local receipts for the running episode_id",
    "world_frame is left_base; right_base must be linked explicitly or through top camera calibration",
    "left/right wrist cam2world is dynamic: world_from_base @ FK(measured qpos at frame) @ T_grasp_to_cam (historical RLinf key stores grasp_from_camera)",
    "cached camera snapshots include frame_age_s and qpos_delta metadata; cam2world for wrist views is approximate unless the robot is stationary",
    "camera_meta includes RealSense distortion_model/distortion_coeffs from the active SDK profile; projection_valid is false for stale frames or moving wrist FK snapshots",
    "camera snapshots use cached background RGBD frames; 30Hz is the command cadence, not a synchronized RGBD capture guarantee",
    "table_z guard checks TCP height only and is not a collision checker; table_z must be configured before real qpos motion or Cartesian execution plans"
  ],
  "rlinf_root": null,
  "operator_receipt_path": "/tmp/rpent_yam_operator_receipt.json",
  "extrinsics_path": null,
  "qpos_static_tolerance_rad": 0.001
